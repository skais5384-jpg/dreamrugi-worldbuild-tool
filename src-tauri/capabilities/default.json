{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:path:allow-resolve-directory",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-guarded",
    "allow-legacy-handoff-status",
    "allow-legacy-handoff-retry",
    "allow-spell-check",
    "allow-spell-cancel",
    "allow-about-version",
    "allow-about-channel",
    "allow-about-open-link",
    "allow-svn-probe",
    "allow-svn-session",
    "allow-svn-login",
    "allow-svn-logout",
    "allow-diagnostic-recent-events",
    "allow-updater-status",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-cancel",
    "allow-updater-continue",
    "allow-updater-release",
    "allow-updater-prepare",
    "allow-updater-close-failed",
    "allow-svn-inspect",
    "allow-svn-checkout",
    "allow-svn-register-preview",
    "allow-svn-register",
    "allow-svn-status",
    "allow-svn-local-document-status",
    "allow-svn-document-lock-owner",
    "allow-svn-force-document-lock",
    "allow-svn-gui-update",
    "allow-svn-gui-cleanup",
    "allow-svn-commit-candidates",
    "allow-svn-schedule-delete",
    "allow-svn-commit",
    "allow-svn-commit-recheck",
    "allow-svn-cancel",
    "allow-svn-policy-snapshot",
    "allow-svn-policy-initialize",
    "allow-svn-policy-save"
  ]
}
