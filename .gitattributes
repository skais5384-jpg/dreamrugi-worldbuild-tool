# 일반 텍스트 파일은 Git이 자동으로 감지하고 줄바꿈을 정규화한다.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
.prettierignore text eol=lf

# 소스 코드와 설정 및 문서 파일은 모든 운영체제에서 LF를 사용한다.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
package-lock.json text eol=lf

# 맞춤법 사전은 Git export와 Windows checkout에서 같은 검증 바이트를 사용한다.
src-tauri/spellcheck/resources/ko.aff text eol=lf
src-tauri/spellcheck/resources/ko.dic text eol=lf

# Windows 전용 배치 스크립트는 Windows 표준 줄바꿈인 CRLF를 사용한다.
*.bat text eol=crlf
*.cmd text eol=crlf

# 이미지 파일은 줄바꿈 변환이나 텍스트 병합을 하지 않는 바이너리로 취급한다.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.icns binary
*.svg binary

# Noto Sans를 포함한 폰트 파일은 손상을 막기 위해 바이너리로 취급한다.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
